# Ignore everything by default
*

# Whitelist directories
!*/

# Whitelist Repo/Package files
!.gitignore
!README.md
!CHANGELOG.md
!LICENSE
!package.json

# Whitelist all common Unity source and asset files
!**/*.cs
!**/*.asmdef
!**/*.unity
!**/*.prefab
!**/*.mat
!**/*.asset
!**/*.fbx
!**/*.png
!**/*.jpg
!**/*.tga
!**/*.inputactions
!**/*.terrainlayer

# Whitelist audio
!**/*.wav
!**/*.mp3
!**/*.ogg
!**/*.flac
!**/*.aiff
!**/*.aif
!**/*.m4a

# Explicitly ignore all .meta files (as requested)
**/*.meta